---
import Layout from '../../layouts/Layout.astro';
import { getAdminFromRequest } from '../../lib/auth';

// If already logged in, redirect to dashboard
const admin = await getAdminFromRequest(Astro.request);
if (admin) return Astro.redirect('/admin');
---

<Layout title="Admin Login" description="Login administrator buku tamu digital" bodyClass="login-page">
  <main class="login-main">
    <div class="login-card animate-fade-in">
      <div class="login-header">
        <img src="/logo.png" alt="Logo" class="login-logo" onerror="this.style.display='none'" />
        <h1 class="login-title">Admin Login</h1>
        <p class="login-subtitle">Buku Tamu Digital</p>
      </div>

      <form id="login-form" class="login-form">
        <div class="form-group">
          <label class="form-label" for="username">Username</label>
          <input type="text" id="username" name="username" class="form-input" placeholder="Masukkan username" required autofocus />
        </div>
        <div class="form-group">
          <label class="form-label" for="password">Password</label>
          <input type="password" id="password" name="password" class="form-input" placeholder="Masukkan password" required />
        </div>
        <div id="login-error" class="login-error" style="display:none"></div>
        <button type="submit" id="btn-login" class="btn-login">Masuk</button>
      </form>

      <a href="/checkin" class="back-link">← Kembali ke halaman Check-In</a>
    </div>
  </main>
</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

  :global(.login-page) { background: #f4f7fb !important; font-family: 'Plus Jakarta Sans', sans-serif; }
  :global(.login-page::before) { display: none; }

  .login-main {
    min-height: 100vh; display: flex; align-items: center; justify-content: center;
    padding: var(--space-xl);
  }
  .login-card {
    width: 100%; max-width: 420px; background: #ffffff;
    border-radius: 20px; padding: var(--space-2xl) var(--space-xl);
    box-shadow: 0 8px 32px rgba(74,134,214,0.08);
    text-align: center;
  }
  .login-header { margin-bottom: var(--space-xl); }
  .login-logo { width: 80px; height: auto; margin: 0 auto var(--space-md); }
  .login-title { font-size: 1.6rem; font-weight: 700; color: #0f172a; }
  .login-subtitle { font-size: 0.95rem; color: #64748b; }

  .login-form { display: flex; flex-direction: column; gap: var(--space-md); text-align: left; }
  .form-label { font-weight: 600; color: #475569; font-size: 0.9rem; display: block; margin-bottom: 6px; }
  .form-input {
    width: 100%; padding: 12px 16px; border: 1px solid #cbd5e1;
    border-radius: 12px; font-size: 1rem; background: #f8fafc;
    color: #0f172a; font-family: inherit; outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .form-input:focus { border-color: #4a86d6; box-shadow: 0 0 0 3px rgba(74,134,214,0.12); background: #fff; }
  .form-input::placeholder { color: #94a3b8; }

  .login-error {
    padding: 10px 14px; background: #fef2f2; border: 1px solid #fecaca;
    border-radius: 10px; color: #dc2626; font-size: 0.9rem;
  }

  .btn-login {
    width: 100%; padding: 14px; border: none; border-radius: 12px;
    background: linear-gradient(to right, #4a86d6, #d4a84a);
    color: #ffffff; font-weight: 700; font-size: 1.1rem;
    cursor: pointer; font-family: inherit; transition: box-shadow 0.2s, transform 0.1s;
  }
  .btn-login:hover { box-shadow: 0 4px 16px rgba(74,134,214,0.25); transform: translateY(-1px); }
  .btn-login:active { transform: scale(0.98); }
  .btn-login:disabled { opacity: 0.6; cursor: not-allowed; }

  .back-link {
    display: inline-block; margin-top: var(--space-lg);
    color: #64748b; font-size: 0.9rem; text-decoration: none;
  }
  .back-link:hover { color: #4a86d6; }
</style>

<script is:inline>
document.getElementById('login-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const btn = document.getElementById('btn-login');
  const errorEl = document.getElementById('login-error');
  errorEl.style.display = 'none';
  btn.disabled = true;
  btn.textContent = 'Memproses...';

  try {
    const res = await fetch('/api/admin/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        username: document.getElementById('username').value.trim(),
        password: document.getElementById('password').value,
      }),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Login gagal');
    window.location.href = '/admin';
  } catch (err) {
    errorEl.textContent = err.message;
    errorEl.style.display = 'block';
    btn.disabled = false;
    btn.textContent = 'Masuk';
  }
});
</script>
